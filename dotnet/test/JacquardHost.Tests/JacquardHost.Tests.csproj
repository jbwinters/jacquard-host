<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8 SDKs build the net8.0 tests; .NET 10 SDKs also build net10.0. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net8.0;net10.0</TargetFrameworks>
    <RootNamespace>JacquardLang.Host.Tests</RootNamespace>
    <AssemblyName>JacquardLang.Host.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- Test names read as sentences. The SDK fixtures run on Linux and macOS
         only (they carry NUnit's Platform attribute), where the Unix file mode
         APIs they use exist. -->
    <NoWarn>$(NoWarn);CA1707;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DotnetRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/JacquardHost/JacquardHost.csproj" />
    <ProjectReference Include="../JacquardHost.StandIn/JacquardHost.StandIn.csproj" />
  </ItemGroup>

</Project>
