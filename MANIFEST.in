recursive-include docs *.md *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.py *.jac *.json *.md
include CHANGELOG.md CONTRIBUTING.md core-pin.json
include LICENSE NOTICE
recursive-include docs/development *.py
recursive-include typescript *.ts *.mjs *.json *.md
prune typescript/node_modules
prune typescript/dist
prune typescript/data
include go/go.mod go/NOTICE
recursive-include go *.go *.md *.json *.jac
include rust/Cargo.toml rust/Cargo.lock rust/rustfmt.toml rust/LICENSE rust/NOTICE
recursive-include rust *.rs *.md *.json *.jac
prune rust/target
include java/pom.xml java/LICENSE java/NOTICE
recursive-include java *.java *.md *.json *.jac
prune java/target
include dotnet/Directory.Build.props dotnet/.editorconfig dotnet/LICENSE dotnet/NOTICE dotnet/JacquardHost.sln
recursive-include dotnet *.cs *.csproj *.md *.json *.jac
prune dotnet/src/JacquardHost/bin
prune dotnet/src/JacquardHost/obj
prune dotnet/test/JacquardHost.Tests/bin
prune dotnet/test/JacquardHost.Tests/obj
prune dotnet/test/JacquardHost.StandIn/bin
prune dotnet/test/JacquardHost.StandIn/obj
