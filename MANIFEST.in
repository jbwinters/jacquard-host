recursive-include docs *.md *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.py *.jac *.json *.md
include CHANGELOG.md CONTRIBUTING.md core-pin.json
include LICENSE NOTICE
recursive-include docs/development *.py
recursive-include typescript *.ts *.mjs *.json *.md
prune typescript/node_modules
prune typescript/dist
prune typescript/data
include go/go.mod go/NOTICE
recursive-include go *.go *.md *.json *.jac
include rust/Cargo.toml rust/Cargo.lock rust/rustfmt.toml rust/LICENSE rust/NOTICE
recursive-include rust *.rs *.md *.json *.jac
prune rust/target
